' Array benchmark: element writes and reads over a large fixed array.

Sub Main()
    Dim data(0 To 1200000) As Int32
    Dim i As Int32
    Dim total As Int32
    For i = 0 To 1200000
        data(i) = i * 3
    Next i
    For i = 0 To 1200000
        total = total + data(i) Mod 11
    Next i
    Console.WriteLine("total=" & total)
End Sub
