' Object benchmark: allocation, field writes, and method dispatch.

Class Point
    Public X As Int32
    Public Y As Int32

    Public Function LengthSquared() As Int32
        Return X * X + Y * Y
    End Function
End Class

Sub Main()
    Dim total As Int32
    Dim i As Int32
    For i = 1 To 250000
        Dim p As New Point()
        p.X = i Mod 100
        p.Y = (i + 1) Mod 100
        total = (total + p.LengthSquared()) Mod 100000
    Next i
    Console.WriteLine("total=" & total)
End Sub
