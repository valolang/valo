' Arithmetic and loop benchmark: nested counting loops with integer math.

Sub Main()
    Dim total As Int32
    Dim i As Int32
    Dim j As Int32
    For i = 1 To 8000
        For j = 1 To 1000
            total = total + (i * j) Mod 7
        Next j
    Next i
    Console.WriteLine("total=" & total)
End Sub
