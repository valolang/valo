Class Box
    Private value As Integer

    Public Sub New(ByVal initial As Integer)
        value = initial
    End Sub

    Public ReadOnly Default Property Item() As Integer
        Get
            Return value
        End Get
    End Property

    Public Sub Terminate()
        Console.WriteLine("terminated")
    End Sub
End Class

Sub Main()
    Dim box As Box
    box = New Box(10)
    Console.WriteLine(box)
    box = Nothing
End Sub
