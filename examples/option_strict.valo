' Option Strict: no conversion that can lose something, and no member reached
' on a value whose type is only known when the program runs.
'
' It is off by default, which is what VBA source expects. Turning it on makes
' every place a value changes shape something you wrote down on purpose.

Option Strict On

Class Account
    Public Owner As String
    Public Balance As Double
End Class

Function Make(ByVal owner As String, ByVal balance As Double) As Account
    Dim account As New Account()
    account.Owner = owner
    account.Balance = balance
    Return account
End Function

Sub Main()
    ' Widening is untouched: nothing is lost putting a Long in a Double.
    Dim rate As Double = 3
    Console.WriteLine(rate)

    ' Narrowing has to be asked for. Without CInt this would be rejected:
    '     Dim rounded As Integer = 3.9
    Dim rounded As Integer = CInt(3.9)
    Console.WriteLine(rounded)

    ' So does turning text into a number, which can fail at run time.
    Dim parsed As Long = CLng("7")
    Console.WriteLine(parsed)

    ' A declared type carries through, so members resolve statically.
    Dim account As Account
    account = Make("Ada", 120.5)
    Console.WriteLine($"{account.Owner}: {account.Balance}")

    ' Holding the same object as a Variant would lose that. This would be
    ' rejected, because nothing here can say whether the member exists:
    '     Dim loose As Variant
    '     Set loose = account
    '     Console.WriteLine(loose.Owner)
    '
    ' Saying what it is brings it back.
    Dim loose As Variant
    loose = account
    Console.WriteLine(CType(loose, Account).Owner)
End Sub
