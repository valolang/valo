' SDL3 bindings for the raycaster.
'
' Every native entry point this demo uses is declared here, so the rest of the
' program never mentions the library. The declarations use `Lib "SDL3"`, which
' the loader resolves against the current directory, the executable's directory,
' and PATH. See game/README.md for where to put the library.
'
' The Breakout demo has its own copy of the bindings it needs. Each demo stays
' something you can read and run on its own, which matters more here than not
' repeating two dozen declarations.

' -- Structures shared with the native ABI --------------------------------

' A rectangle in renderer coordinates: SDL_FRect.
Public Type FRect
    X As Single
    Y As Single
    W As Single
    H As Single
End Type

' SDL_Event, which is a 128-byte union.
'
' Only the header and the keyboard payload are named; the rest is padding that
' exists so the struct is the size the native side writes into. The offsets are
' fixed by SDL_KeyboardEvent: the event kind leads, and the scancode sits at
' byte 24.
Public Type SdlEvent
    Kind As Int32
    Reserved As Int32
    TimestampLow As Int32
    TimestampHigh As Int32
    WindowId As Int32
    Which As Int32
    Scancode As Int32
    KeyCode As Int32
    Pad08 As Int32
    Pad09 As Int32
    Pad10 As Int32
    Pad11 As Int32
    Pad12 As Int32
    Pad13 As Int32
    Pad14 As Int32
    Pad15 As Int32
    Pad16 As Int32
    Pad17 As Int32
    Pad18 As Int32
    Pad19 As Int32
    Pad20 As Int32
    Pad21 As Int32
    Pad22 As Int32
    Pad23 As Int32
    Pad24 As Int32
    Pad25 As Int32
    Pad26 As Int32
    Pad27 As Int32
    Pad28 As Int32
    Pad29 As Int32
    Pad30 As Int32
    Pad31 As Int32
End Type

' -- Native entry points ------------------------------------------------

Public Declare Function SDL_Init Lib "SDL3" CDecl (ByVal flags As Int32) As Byte
Public Declare Sub SDL_Quit Lib "SDL3" CDecl ()

Public Declare Function SDL_CreateWindow Lib "SDL3" CDecl ( _
    ByVal title As String, ByVal width As Int32, ByVal height As Int32, ByVal flags As Int64) As Ptr
Public Declare Sub SDL_DestroyWindow Lib "SDL3" CDecl (ByVal window As Ptr)
Public Declare Function SDL_SetWindowTitle Lib "SDL3" CDecl ( _
    ByVal window As Ptr, ByVal title As String) As Byte

Public Declare Function SDL_CreateRenderer Lib "SDL3" CDecl ( _
    ByVal window As Ptr, ByVal name As Ptr) As Ptr
Public Declare Sub SDL_DestroyRenderer Lib "SDL3" CDecl (ByVal renderer As Ptr)
Public Declare Function SDL_SetRenderDrawColor Lib "SDL3" CDecl ( _
    ByVal renderer As Ptr, ByVal red As Byte, ByVal green As Byte, _
    ByVal blue As Byte, ByVal alpha As Byte) As Byte
Public Declare Function SDL_RenderClear Lib "SDL3" CDecl (ByVal renderer As Ptr) As Byte
Public Declare Sub SDL_RenderPresent Lib "SDL3" CDecl (ByVal renderer As Ptr)
Public Declare Function SDL_RenderFillRect Lib "SDL3" CDecl ( _
    ByVal renderer As Ptr, ByRef rect As FRect) As Byte
Public Declare Function SDL_RenderLine Lib "SDL3" CDecl ( _
    ByVal renderer As Ptr, ByVal x1 As Single, ByVal y1 As Single, _
    ByVal x2 As Single, ByVal y2 As Single) As Byte
Public Declare Function SDL_PollEvent Lib "SDL3" CDecl (ByRef nativeEvent As SdlEvent) As Byte
Public Declare Sub SDL_Delay Lib "SDL3" CDecl (ByVal milliseconds As Int32)
Public Declare Function SDL_GetTicks Lib "SDL3" CDecl () As Int64

' -- Constants ----------------------------------------------------------

Public Const INIT_VIDEO As Int32 = 32

Public Const EVENT_QUIT As Int32 = 256
Public Const EVENT_KEY_DOWN As Int32 = 768
Public Const EVENT_KEY_UP As Int32 = 769

Public Const KEY_A As Int32 = 4
Public Const KEY_D As Int32 = 7
Public Const KEY_M As Int32 = 16
Public Const KEY_Q As Int32 = 20
Public Const KEY_S As Int32 = 22
Public Const KEY_W As Int32 = 26
Public Const KEY_E As Int32 = 8
Public Const KEY_ESCAPE As Int32 = 41
Public Const KEY_RIGHT As Int32 = 79
Public Const KEY_LEFT As Int32 = 80
Public Const KEY_DOWN As Int32 = 81
Public Const KEY_UP As Int32 = 82

' -- Helpers ------------------------------------------------------------

Public Function IsForwardKey(ByVal scancode As Int32) As Boolean
    Return scancode = KEY_W Or scancode = KEY_UP
End Function

Public Function IsBackKey(ByVal scancode As Int32) As Boolean
    Return scancode = KEY_S Or scancode = KEY_DOWN
End Function

Public Function IsTurnLeftKey(ByVal scancode As Int32) As Boolean
    Return scancode = KEY_A Or scancode = KEY_LEFT
End Function

Public Function IsTurnRightKey(ByVal scancode As Int32) As Boolean
    Return scancode = KEY_D Or scancode = KEY_RIGHT
End Function
