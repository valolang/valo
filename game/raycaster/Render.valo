' The raycaster: turning a position and a direction into a picture.
'
' One ray per screen column walks the grid until it meets a wall, and how far it
' travelled decides how tall that wall is drawn. Everything else here is what
' makes the result look like a place rather than a set of stripes: a procedural
' texture down each slice, distance fog, banded floor and ceiling, and sprites
' composited against the depth the walls left behind.

Imports World
Imports Sdl

' How many rays are cast across the view.
'
' The cost of a frame is almost exactly this number times the work per ray, so
' it is the dial to turn when the frame rate matters more than the detail.
Public Const COLUMNS As Int32 = 160

' How many bands each wall slice is drawn in.
'
' Sampling the texture once per band rather than once per pixel is what makes a
' texture affordable at all here: eight rectangles instead of a few hundred.
Public Const BANDS As Int32 = 8

' Sized COLUMNS - 1. Written as a literal because an array bound has to be one.
Private Depth(0 To 159) As Double

Public Function DepthAt(ByVal column As Int32) As Double
    Return Depth(column)
End Function

' Where a ray stopped, and against what.
Public Structure Hit
    ' Distance along the camera's forward axis, not to the eye. Using the
    ' perpendicular distance is what keeps walls flat instead of bowing outwards
    ' towards the edges of the view.
    Public Distance As Double
    Public Material_ As Int32
    ' True when the ray crossed a north or south face, which is drawn darker so
    ' corners read as corners.
    Public Sideways As Boolean
    ' Where along the wall face the ray landed, between 0 and 1. The texture
    ' reads from this.
    Public Offset As Double
End Structure

' Walks the grid until the ray meets a wall.
'
' Digital differential analysis: rather than stepping a fixed distance and
' hoping not to skip a cell, it jumps from grid line to grid line, so every cell
' the ray crosses is visited exactly once.
Public Function Cast(ByVal origin As Vec2, ByVal direction As Vec2) As Hit
    Dim cellX As Int32 = CLng(Fix(origin.X))
    Dim cellY As Int32 = CLng(Fix(origin.Y))

    ' How far the ray travels to cross one whole cell in each axis.
    Dim stepCostX As Double = 1000000
    If direction.X <> 0 Then
        stepCostX = Abs(1 / direction.X)
    End If
    Dim stepCostY As Double = 1000000
    If direction.Y <> 0 Then
        stepCostY = Abs(1 / direction.Y)
    End If

    Dim stepX As Int32 = 1
    Dim nextX As Double = (cellX + 1 - origin.X) * stepCostX
    If direction.X < 0 Then
        stepX = -1
        nextX = (origin.X - cellX) * stepCostX
    End If

    Dim stepY As Int32 = 1
    Dim nextY As Double = (cellY + 1 - origin.Y) * stepCostY
    If direction.Y < 0 Then
        stepY = -1
        nextY = (origin.Y - cellY) * stepCostY
    End If

    Dim sideways As Boolean = False
    Dim surface As Int32 = Material.Open_
    Dim guard As Int32 = 0

    Do While surface = Material.Open_ And guard < 64
        guard = guard + 1
        If nextX < nextY Then
            nextX = nextX + stepCostX
            cellX = cellX + stepX
            sideways = False
        Else
            nextY = nextY + stepCostY
            cellY = cellY + stepY
            sideways = True
        End If
        surface = World.At(cellX, cellY)
    Loop

    Dim result As Hit
    result.Material_ = surface
    result.Sideways = sideways
    If sideways Then
        result.Distance = nextY - stepCostY
        result.Offset = origin.X + result.Distance * direction.X
    Else
        result.Distance = nextX - stepCostX
        result.Offset = origin.Y + result.Distance * direction.Y
    End If
    result.Offset = result.Offset - Fix(result.Offset)
    If result.Distance < 0.01 Then
        result.Distance = 0.01
    End If
    Return result
End Function

' A brightness for one patch of wall, from its material and where on the face it
' sits.
'
' There is no image behind this: the pattern is arithmetic, which is what makes
' it cost a multiply instead of a memory fetch and a texture upload.
Private Function TextureLight(ByVal surface As Int32, ByVal across As Double, ByVal down As Double) As Double
    Select Case surface
        Case Material.Brick
            ' Courses of bricks, offset every other row.
            Dim row As Int32 = CLng(Fix(down * 8))
            Dim shifted As Double = across
            If row Mod 2 = 0 Then
                shifted = across + 0.5
            End If
            Dim inCourse As Double = shifted - Fix(shifted)
            If inCourse < 0.06 Or down * 8 - row < 0.12 Then
                Return 0.55
            End If
            Return 1
        Case Material.Stone
            ' Blocks, with the mortar picked out.
            If across - Fix(across * 4) / 4 < 0.03 Or down - Fix(down * 4) / 4 < 0.03 Then
                Return 0.6
            End If
            Return 0.95 + 0.05 * Sin(across * 12 + down * 7)
        Case Material.Metal
            ' Vertical ribs.
            Return 0.7 + 0.3 * Abs(Sin(across * 25))
        Case Material.Moss
            ' Patchy, and heavier towards the bottom.
            Return 0.65 + 0.35 * Abs(Sin(across * 9 + down * 5)) * (1.2 - down * 0.4)
        Case Material.Glass
            ' Panes with bright edges.
            Dim edge As Double = Abs(across - 0.5)
            If edge > 0.42 Then
                Return 1.25
            End If
            Return 0.8 + 0.2 * Sin(down * 18)
        Case Else
            Return 1
    End Select
End Function

' How much of a surface survives the distance to it.
Private Function Fog(ByVal distance As Double) As Double
    Dim light As Double = 1 - distance / 18
    If light < 0.12 Then
        light = 0.12
    End If
    Return light
End Function

Private Sub FillRect( _
        ByVal renderer As Ptr, ByVal color As Int32, _
        ByVal x As Double, ByVal y As Double, ByVal w As Double, ByVal h As Double)
    SDL_SetRenderDrawColor(renderer, _
        CByte(RedOf(color)), CByte(GreenOf(color)), CByte(BlueOf(color)), CByte(255))
    Dim shape As FRect
    shape.X = CSng(x)
    shape.Y = CSng(y)
    shape.W = CSng(w)
    shape.H = CSng(h)
    SDL_RenderFillRect(renderer, shape)
End Sub

' Draws the sky and the floor as bands that darken towards the horizon.
Private Sub DrawBackdrop(ByVal renderer As Ptr, ByVal width As Double, ByVal height As Double)
    Const STEPS As Int32 = 12
    Dim half As Double = height / 2
    Dim band As Int32
    For band = 0 To STEPS - 1
        Dim t As Double = band / STEPS
        Dim y As Double = t * half

        ' Sky: brighter overhead.
        Dim sky As Int32 = PackColor( _
            CLng(28 + 40 * (1 - t)), CLng(34 + 54 * (1 - t)), CLng(58 + 74 * (1 - t)))
        FillRect(renderer, sky, 0, y, width, half / STEPS + 1)

        ' Floor: brighter close to the camera, which is the bottom of the view.
        Dim floor_ As Int32 = PackColor( _
            CLng(24 + 44 * t), CLng(22 + 36 * t), CLng(20 + 30 * t))
        FillRect(renderer, floor_, 0, height - y - half / STEPS - 1, width, half / STEPS + 2)
    Next band
End Sub

' Casts every column and draws what each one hit.
Public Sub DrawWalls( _
        ByVal renderer As Ptr, ByVal eye As Vec2, ByVal forward As Vec2, _
        ByVal plane As Vec2, ByVal width As Double, ByVal height As Double)
    DrawBackdrop(renderer, width, height)

    Dim columnWidth As Double = width / COLUMNS
    Dim column As Int32
    For column = 0 To COLUMNS - 1
        ' Where this column sits across the view, from -1 at the left edge to 1
        ' at the right.
        Dim across As Double = 2 * column / COLUMNS - 1
        Dim ray As Vec2 = forward + plane * across

        Dim hit As Hit = Cast(eye, ray)
        Depth(column) = hit.Distance

        Dim wallHeight As Double = height / hit.Distance
        Dim top As Double = (height - wallHeight) / 2
        If top < 0 Then
            top = 0
        End If
        Dim bottom As Double = (height + wallHeight) / 2
        If bottom > height Then
            bottom = height
        End If

        Dim base As Int32 = ColorOf(hit.Material_)
        Dim light As Double = Fog(hit.Distance)
        If hit.Sideways Then
            light = light * 0.72
        End If

        ' The slice is drawn in bands so the texture varies down the wall as
        ' well as across it.
        Dim bandHeight As Double = (bottom - top) / BANDS
        Dim band As Int32
        For band = 0 To BANDS - 1
            Dim down As Double = (band + 0.5) / BANDS
            Dim patch As Double = TextureLight(hit.Material_, hit.Offset, down)
            FillRect(renderer, Shade(base, light * patch), _
                column * columnWidth, top + band * bandHeight, _
                columnWidth + 1, bandHeight + 1)
        Next band
    Next column
End Sub
